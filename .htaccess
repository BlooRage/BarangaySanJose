Options -Indexes
Options -MultiViews

# Upload ceiling high enough for app-level resident/admin file limits.
<IfModule mod_php.c>
php_value upload_max_filesize 64M
php_value post_max_size 256M
php_value max_file_uploads 40
</IfModule>

<IfModule mod_php_module>
php_value upload_max_filesize 64M
php_value post_max_size 256M
php_value max_file_uploads 40
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On

# Block hidden files/folders (except ACME challenge paths if ever used)
RewriteRule "(^|/)\.(?!well-known/)" - [F,L]

# Block repository and editor artifacts
RewriteRule "(^|/)\.git" - [F,L,NC]
RewriteRule "(^|/)\.svn" - [F,L,NC]
RewriteRule "(^|/)desktop\.ini$" - [F,L,NC]
RewriteRule "(^|/)\.DS_Store$" - [F,L,NC]

# Block sensitive docs and config-like files that should never be public
RewriteRule "(^|/)DATABASE QUERIES\.txt$" - [F,L,NC]
RewriteRule "(^|/)config\.runtime(?:\.local|\.example)?\.php$" - [F,L,NC]
RewriteRule "(^|/)PhpFiles/General/runtime(?:\.local)?\.php$" - [F,L,NC]
RewriteRule "(^|/)composer-email-handler/(composer\.(json|lock)|vendor/)" - [F,L,NC]
RewriteRule "(^|/)PhpFiles/PhpOffice/composer-setup\.php$" - [F,L,NC]
RewriteRule "(^|/)PhpFiles/PhpOffice/vendor/" - [F,L,NC]
RewriteRule "(^|/).*\.(sql|bak|old|orig|ini|log|env)$" - [F,L,NC]

# Optional direct maintenance page route, kept available for future use.
RewriteRule ^Guest-End/maintenance/?$ Guest-End/maintenance.php [L,NC]
RewriteRule ^maintenance/?$ Guest-End/maintenance.php [L,NC]

RewriteRule ^index/?$ index.html [L,NC]
RewriteRule ^Guest-End/login/?$ Guest-End/login.php [L,NC]
RewriteRule ^Guest-End/government/?$ Guest-End/government.html [L,NC]
RewriteRule ^Guest-End/services/?$ Guest-End/services.html [L,NC]
RewriteRule ^Guest-End/news/?$ Guest-End/news.html [L,NC]
RewriteRule ^Guest-End/faq/?$ Guest-End/faq.html [L,NC]
RewriteRule ^Guest-End/contact/?$ Guest-End/contact.html [L,NC]
RewriteRule ^Guest-End/TransactionInformation/?$ Guest-End/TransactionInformation.html [L,NC]
RewriteRule ^Guest-End/official_onboarding/?$ Guest-End/official_onboarding.php [L,NC]
RewriteRule ^Guest-End/verifyEmail/?$ Guest-End/verifyEmail.php [L,NC]

# Friendly public routes
RewriteRule ^$ index.html [L]
RewriteRule ^home/?$ index.html [L,NC]
RewriteRule ^privacy/?$ privacy.html [L,NC]
RewriteRule ^login/?$ Guest-End/login.php [L,NC]
RewriteRule ^government/?$ Guest-End/government.html [L,NC]
RewriteRule ^services/?$ Guest-End/services.html [L,NC]
RewriteRule ^news/?$ Guest-End/news.html [L,NC]
RewriteRule ^faq/?$ Guest-End/faq.html [L,NC]
RewriteRule ^contact/?$ Guest-End/contact.html [L,NC]
RewriteRule ^transactions/?$ Guest-End/TransactionInformation.html [L,NC]
RewriteRule ^transaction-information/?$ Guest-End/TransactionInformation.html [L,NC]
RewriteRule ^official-onboarding/?$ Guest-End/official_onboarding.php [L,NC]
RewriteRule ^verify-email/?$ Guest-End/verifyEmail.php [L,NC]
RewriteRule ^logout/?$ PhpFiles/Login/logout.php [L,NC]
RewriteRule ^account-redirect/?$ PhpFiles/Login/unifiedProfileCheck.php [L,NC]

# Public page URLs: redirect GET/HEAD requests from *.php / *.html to extensionless paths.
# Keep PhpFiles endpoints untouched so POST actions and AJAX routes continue to work normally.
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$ [NC]
RewriteCond %{REQUEST_URI} !/PhpFiles/ [NC]
RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.(?:php|html)(?:\?|\s) [NC]
RewriteRule ^ /%1 [R=302,L,NE]

# Resolve extensionless public page URLs back to their real PHP/HTML files.
RewriteCond %{REQUEST_URI} !/PhpFiles/ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L]

RewriteCond %{REQUEST_URI} !/PhpFiles/ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>
